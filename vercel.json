{
  "buildCommand": "npm --prefix vfinance/client run build",
  "outputDirectory": "vfinance/client/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://emissions-neon-coupled-family.trycloudflare.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://emissions-neon-coupled-family.trycloudflare.com/uploads/:path*" },
    { "source": "/((?!api/).*)", "destination": "/" }
  ]
}
